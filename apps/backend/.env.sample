DEVMIND_PRIMARY.ENV="local"

DEVMIND_SERVER.PORT="8080"
DEVMIND_SERVER.READ_TIMEOUT="30"
DEVMIND_SERVER.WRITE_TIMEOUT="30"
DEVMIND_SERVER.IDLE_TIMEOUT="60"
DEVMIND_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:5173,https://devmind.vercel.app"

DEVMIND_DATABASE.HOST="localhost"
DEVMIND_DATABASE.PORT="5432"
DEVMIND_DATABASE.USER="postgres"
DEVMIND_DATABASE.PASSWORD=""
DEVMIND_DATABASE.NAME="devmind"
DEVMIND_DATABASE.SSL_MODE="disable"
DEVMIND_DATABASE.MAX_OPEN_CONNS="25"
DEVMIND_DATABASE.MAX_IDLE_CONNS="25"
DEVMIND_DATABASE.CONN_MAX_LIFETIME="300"
DEVMIND_DATABASE.CONN_MAX_IDLE_TIME="300"

DEVMIND_AUTH.SECRET_KEY="secret"

DEVMIND_INTEGRATION.RESEND_API_KEY="resend_key"

DEVMIND_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
DEVMIND_OBSERVABILITY.SERVICE_NAME="devmind"
DEVMIND_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
DEVMIND_OBSERVABILITY.LOGGING.LEVEL="debug"
DEVMIND_OBSERVABILITY.LOGGING.FORMAT="console"
DEVMIND_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
DEVMIND_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DEVMIND_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
DEVMIND_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
DEVMIND_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
DEVMIND_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
DEVMIND_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
DEVMIND_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
DEVMIND_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"